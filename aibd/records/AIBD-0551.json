  "replication": {
    "produced_by": [
      "The pilot began with a small social-worker group and expanded, using templates adapted with council feedback.",
      "The tool supports mobile recording and produces material for the existing case-management workflow."
    ],
    "must_hold": [
      "Practitioners are expected to obtain participants’ consent for recording.",
      "The source reports that poor audio and limited verbal detail can reduce transcript quality, and staff retain responsibility for editing outputs."
