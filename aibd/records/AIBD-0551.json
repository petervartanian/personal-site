      "depth": 1,
      "reason": "Workers report less documentation effort and time. Improvements in service users’ health or care are unmeasured."
    }
  ],
  "ai_role": {
    "status": "assessed",
    "statement": "Magic Notes transcribes and summarizes care and supervision conversations. Staff review, amend, and supplement outputs. The council attributes documentation savings to this assisted workflow, without establishing improved service-user outcomes."
