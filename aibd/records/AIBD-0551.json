{
  "id": "AIBD-0551",
  "title": "Kingston Council: Using AI in Adult Social Care administration",
  "summary": "Kingston reports that Magic Notes cuts documentation time by 50–60%, with supervision write-ups falling from 40 minutes to under 10.",
  "date_observed": "2025-01-28",
  "date_basis": "source publication",
  "date_precision": "day",
  "benefit_status": "reported",
  "source_collection": "LGA AI case-study bank",
  "source_entry": "LGA-011",
  "account": "Kingston piloted Beam Magic Notes to transcribe and summarize adult-social-care conversations, assessments, and supervision. The council reports 50–60% less time completing notes and assessments, and supervision write-ups falling from 40 minutes to under 10 minutes. The source reports limitations for people with low verbal skills or mental capacity and with poor audio quality.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "Reduce social-care documentation work by transcribing and summarizing conversations into usable notes and assessments.",
  "system": "Beam Magic Notes",
  "model_version": null,
  "developer": "Beam",
  "deployer": "Kingston Council",
  "location": "United Kingdom",
  "domain": "Adult social-care administration",
  "segment": null,
  "benefit_type": "Improved Organizational Efficiency",
