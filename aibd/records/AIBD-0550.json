{
  "id": "AIBD-0550",
  "title": "Kent County Council: Using predictive analytics to prevent homelessness in Maidstone and Kent",
  "summary": "Kent reports under 1% homelessness among proactively supported households versus 40% in an unsupported comparator. The groups were not randomized.",
  "date_observed": "2026-10-22",
  "date_basis": "source access",
  "date_precision": "day",
  "benefit_status": "reported",
  "source_collection": "LGA AI case-study bank",
  "source_entry": "LGA-010",
  "account": "Kent describes Maidstone’s use of an AI-enabled Xantura platform to flag households for proactive homelessness support and a wider county pilot. The council presenter reports that fewer than 1% of supported alerted households became homeless, compared with 40% of a group that lacked support because of limited capacity. The comparison was not randomized and does not separate AI’s effect from the support intervention. Outcome dates are unspecified.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "Identify households at risk of homelessness so that councils can offer proactive support.",
  "system": "Xantura AI-enabled predictive-analytics platform used for homelessness prevention",
  "model_version": null,
  "developer": "Xantura",
  "deployer": "Maidstone Borough Council and Kent County Council with participating district and borough councils",
  "location": "United Kingdom",
  "domain": "Housing and homelessness prevention",
  "segment": null,
  "benefit_type": "Reduced Risk",
  "taxonomy_note": null,
  "registry_ids": {},
  "ratings": [
    {
      "group": "personal",
      "depth": 4,
      "reason": "The council reports that proactive support prevented homelessness in a high-risk cohort. The groups were not randomized, and AI’s separate effect is unknown."
    },
    {
      "group": "organizational",
      "depth": 2,
      "reason": "The reported prevention program improves targeting and preventive results for councils. The source does not supply sample sizes or an independent evaluation."
    }
  ],
  "ai_role": {
    "status": "unassessed",
    "statement": "The presenter describes an AI-enabled platform that combines council data and flags households for human support. The prevention comparison concerns the combined targeting-and-support program. Because support was capacity-constrained and not randomized, AI’s separate contribution to the difference is not established."
  },
