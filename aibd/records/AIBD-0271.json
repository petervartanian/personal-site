{
  "id": "AIBD-0271",
  "title": "GPT-5 names caruncle oncocytoma from slit-lamp photos in two retrospective cases, months after histology",
  "summary": "Sassari ophthalmologists gave ChatGPT (GPT-5) slit-lamp photos and brief summaries of two surgically confirmed caruncular oncocytomas; it proposed oncocytoma first in both. Retrospective proof only.",
  "date_observed": "2025-09-08",
  "date_basis": "unassessed",
  "date_precision": "unassessed",
  "benefit_status": null,
  "source_collection": null,
  "source_entry": null,
  "account": "Sacchi et al. (Frontiers in Ophthalmology, 24 April 2026) retrospectively analyzed two cases of caruncular oncocytoma. Both had been excised and confirmed histopathologically. ChatGPT (GPT-5, 2025 version) received only slit-lamp photographs and a brief summary (age, sex, site). It proposed oncocytoma as the primary hypothesis in both. Differentials included papilloma, nevus, squamous cell carcinoma and melanoma. The authors call it a proof of concept that a general-purpose multimodal model can recognize a rare ocular surface tumor, limited by the sample size. The analysis was run on 8 September 2025, months after confirmation, with no effect on care. The authors declare no competing interests. Publication was 24 April 2026.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "Test whether a multimodal large language model can generate diagnostic hypotheses from slit-lamp images",
  "system": "ChatGPT (GPT-5, 2025 version)",
  "model_version": "GPT-5 (2025)",
  "developer": "OpenAI",
  "deployer": "Department of Medicine, Surgery and Pharmacy, University of Sassari",
  "location": "Sassari, Italy",
  "domain": "Health; ophthalmology",
  "segment": "Patients with rare ocular adnexal tumors (retrospective)",
  "benefit_type": "Improved Task Accuracy",
  "taxonomy_note": "A retrospective diagnostic match with no effect on care is read as task performance.",
