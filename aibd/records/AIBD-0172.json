{
  "id": "AIBD-0172",
  "title": "Germany deploys IdentiFlight cameras to slow turbines for lesser spotted eagles",
  "summary": "The OECD AI Incidents Monitor records Germany's deployment of IdentiFlight AI cameras to detect lesser spotted eagles near wind turbines and slow the blades (September 2022); no German outcome data.",
  "date_observed": "2022-09-20",
  "date_basis": "unassessed",
  "date_precision": "unassessed",
  "benefit_status": null,
  "source_collection": null,
  "source_entry": null,
  "account": "The OECD AI Incidents entry summarizes press coverage of 20 and 21 September 2022 (The Guardian, Mother Jones, The Register and others, not among the sources). It says Germany is deploying AI-powered camera systems developed by IdentiFlight to detect endangered lesser spotted eagles near wind turbines. They slow the blades to prevent fatal collisions, as wind-farm expansion raises the risk to the species. The monitor's rationale cites the 82% reduction reported from the Wyoming study rather than any German measurement. Only the registry page is among the sources; the sites, operators and any fatality data in Germany are not documented.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "IdentiFlight is built to detect eagles and curtail turbines; protecting lesser spotted eagles at German wind farms is the intended use.",
  "system": "IdentiFlight automated eagle detection and turbine curtailment",
  "model_version": null,
  "developer": "IdentiFlight",
  "deployer": null,
  "location": "Germany",
  "domain": "Energy",
  "segment": "Wind power wildlife mitigation",
