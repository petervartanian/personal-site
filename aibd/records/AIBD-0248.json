{
  "id": "AIBD-0248",
  "title": "Optage and Sanyo Electric Railway trial AI analysis of crossing cameras at three crossings, August to October 2020, with full deployment targeted for spring 2021",
  "summary": "Mynavi News (12 Aug 2020, from a press release): edge-device AI detects people including prams and wheelchairs in crossings and signals drivers via special signal lamps and an IP-VPN link to the op...",
  "date_observed": "2020-08-12",
  "date_basis": "unassessed",
  "date_precision": "unassessed",
  "benefit_status": null,
  "source_collection": null,
  "source_entry": null,
  "account": "Mynavi News reported on 12 Aug 2020, from a press release, a field trial of AI image analysis of crossing surveillance cameras. Optage, Sanyo Electric Railway and the Sanyo Electric Railway Information Center had begun it. It ran from early August to mid-October 2020 at three crossings on Sanyo Electric Railway lines. Edge devices analyze the video in real time to detect people, including those with prams or wheelchairs. They aim to stop trains safely by signaling the driver through a special signal lamp and notifying the operations center over an IP-VPN. Accuracy in rain and at night was to be verified with K4Digital. Full deployment was targeted for spring 2021. No results are reported, and the OECD AI Incidents Monitor entry notes that no incidents had been reported.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "The trial was built to detect people in crossings in real time and alert train drivers.",
  "system": "AI image analysis of crossing cameras on edge devices with special-signal-lamp and IP-VPN alerts",
  "model_version": null,
  "developer": "Optage (with K4Digital for accuracy verification)",
  "deployer": "Sanyo Electric Railway and Sanyo Electric Railway Information Center (trial)",
