{
  "id": "AIBD-0171",
  "title": "ENEA and partners test a machine-learning system to forecast heatwave-driven grid failures in Italy",
  "summary": "The OECD AI Incidents Monitor records that ENEA, Politecnico di Bari and Università Roma Tre developed and tested an ML system to predict heatwave-induced grid failures (May 2023); no outcome given.",
  "date_observed": "2023-05-24",
  "date_basis": "unassessed",
  "date_precision": "unassessed",
  "benefit_status": null,
  "source_collection": null,
  "source_entry": null,
  "account": "The OECD AI Incidents entry summarizes Italian press items of 24 to 26 May 2023 (Askanews, Teknoring, Ingenio and others, not among the sources). It says researchers from ENEA, Politecnico di Bari and Università Roma Tre developed and tested an AI-based system. It uses machine learning to predict and prevent electrical grid failures caused by heatwaves. It targets urban areas affected by climate change. The monitor labels it an AI hazard rather than an incident because the system is designed to prevent harm and no realized event is reported. The registry page is the only source on record. No deployment, grid operator or avoided outage is documented.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "The system was built to forecast heatwave-related failures on electricity networks so operators can act in advance. The record documents development and testing only.",
