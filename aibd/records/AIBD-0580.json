{
  "id": "AIBD-0580",
  "title": "Lynxight alerts lifeguards to an unconscious swimmer at Inglewood Pool; he recovers fully after rescue",
  "summary": "A swimmer recovered fully after a medical episode in Inglewood Pool. Lynxight alerted lifeguards while another swimmer brought him to the surface.",
  "date_observed": "2025-06-10",
  "date_basis": "event",
  "date_precision": "day",
  "benefit_status": "reported",
  "source_collection": null,
  "source_entry": null,
  "account": "On June 10, 2025, a man suffered a medical episode and sank in the outdoor pool at Stirling Leisure - Inglewood, Perth. Lynxight sent lifeguard Cameron Menzies a smartwatch alert with the swimmer's location and images. Another swimmer, Ofer Lefelman, independently noticed the emergency and lifted the man to the surface. Menzies and fellow lifeguards brought him out of the water. The City of Stirling reports that he was conscious when paramedics took him away and later recovered fully. ABC subsequently interviewed the city's operations coordinator, who credited the alert with accelerating the lifeguard's response.",
  "category": "harm prevented",
  "unexpected": false,
  "purpose": "Detect swimmers in distress and alert lifeguards.",
  "system": "Lynxight AI pool monitoring with CCTV analysis and smartwatch alerts",
  "model_version": null,
  "developer": "Lynxight",
  "deployer": "City of Stirling",
  "location": "Stirling Leisure - Inglewood, Perth, Western Australia, Australia",
  "domain": "Aquatic safety and rescue",
  "segment": "Public swimming pools",
  "benefit_type": "Improved Physical Health",
  "taxonomy_note": null,
  "registry_ids": {},
  "ratings": [
    {
      "group": "personal",
      "depth": 5,
      "reason": "An unconscious swimmer survived and recovered fully after a rescue supported by an AI alert. Another swimmer also intervened independently."
    }
  ],
  "ai_role": {
    "status": "assessed",
    "statement": "Lynxight detected distress and alerted the lifeguard, who had not seen the man sink. Human rescuers brought him to safety. Whether he would have survived without the alert is unknown."
  },
  "evidence": [
    {
      "kind": "press release",
      "citation": "City of Stirling, July 1, 2025.",
      "title": "Power of anti-drowning technology on display at Stirling Leisure - Inglewood in WA’s first AI-assisted pool rescue",
      "url": "https://www.stirling.wa.gov.au/city-and-council/news/power-of-anti-drowning-technology-on-display-at-stirling-leisure-%E2%80%93-inglewood-in-wa%E2%80%99s-first-ai-assist",
      "date": "2025-07-01",
      "written_by": "deployer",
      "quote": "The swimmer was conscious and talking when he was taken away by paramedics and has since made a full recovery."
    },
    {
      "kind": "news report",
      "citation": "Lauren Smith and Isabel Moussalli, ABC News, December 31, 2025.",
      "title": "AI technology gives swimming pool lifeguards an extra set of eyes this summer",
      "url": "https://www.abc.net.au/news/2025-12-31/ai-system-to-help-lifeguards-in-pools-swim-safety/106172140",
      "date": "2025-12-31",
      "written_by": "independent",
      "quote": "our lifeguard was there pretty much a few seconds after that"
    },
    {
      "kind": "news report",
      "citation": "Rebeka Petroska, PerthNow, July 3, 2025, reporting Ofer Lefelman's interview with 7NEWS.",
      "title": "AI pool monitoring system in Stirling helps save life of swimmer suffering medical episode in the water",
