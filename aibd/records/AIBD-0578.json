{
  "id": "AIBD-0578",
  "title": "AI-ECG mortality alerts reduce 90-day deaths in a randomized trial in Taiwan",
  "summary": "A Taiwanese randomized trial involving 15,965 patients found 90-day mortality of 3.6% with AI-ECG alerts versus 4.3% with usual care.",
  "date_observed": "2024-04-29",
  "date_basis": "source publication",
  "date_precision": "day",
  "benefit_status": "reported",
  "source_collection": null,
  "source_entry": null,
  "account": "An academic medical center and a community hospital in Taiwan tested AI-ECG alerts with 39 physicians and 15,965 patients. Patients were randomly assigned to AI-assisted care or usual care. Ninety-day all-cause mortality, the primary endpoint, was 3.6% versus 4.3%, respectively: hazard ratio 0.83, with a 95% confidence interval of 0.70–0.99. The prespecified high-risk subgroup had a hazard ratio of 0.69 (0.53–0.90). The trial covered ECGs collected from December 15, 2021, through April 30, 2022. Longer-term survival and generalizability to other health systems remain uncertain.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "Identify patients at high risk of death and prompt timely clinical assessment.",
  "system": "AI-ECG mortality prediction and physician alert system",
  "model_version": null,
  "developer": "National Defense Medical Center and Tri-Service General Hospital research team",
  "deployer": "An academic medical center and a community hospital in Taiwan",
  "location": "Taiwan",
  "domain": "Healthcare - mortality prevention",
  "segment": "ECG-based clinical decision support",
  "benefit_type": "Improved Physical Health",
  "taxonomy_note": null,
  "registry_ids": {
    "clinicaltrials_gov": "NCT05118035"
  },
  "ratings": [
    {
      "group": "personal",
      "depth": 5,
      "reason": "The randomized trial found lower all-cause mortality with AI-assisted care, supporting a survival benefit for patients."
    }
  ],
  "ai_role": {
    "status": "assessed",
    "statement": "A convolutional neural network assessed ECGs and sent high-risk alerts to physicians. Clinicians selected further assessment and treatment. The trial evaluated this combined care pathway. The precise mechanism of the survival improvement remains uncertain."
  },
  "evidence": [
    {
      "kind": "peer-reviewed study",
      "citation": "Lin CS, Liu WT, Tsai DJ, et al. (2024). Nature Medicine 30:1461–1470. doi:10.1038/s41591-024-02961-4. Randomized trial conducted by the system's research team.",
      "title": "AI-enabled electrocardiography alert intervention and all-cause mortality: a pragmatic randomized clinical trial",
      "url": "https://www.nature.com/articles/s41591-024-02961-4",
      "date": "2024-04-29",
      "written_by": "makers",
      "quote": null
    },
    {
      "kind": "peer-reviewed study",
      "citation": "Hsieh PH, Lin C, Lin CS, et al. (2025). npj Digital Medicine 8:348. doi:10.1038/s41746-025-01735-7. Analysis of the same trial.",
      "title": "Economic analysis of an AI-enabled ECG alert system: impact on mortality outcomes from a pragmatic randomized trial",
      "url": "https://www.nature.com/articles/s41746-025-01735-7",
      "date": "2025-06-11",
      "written_by": "deployer",
      "quote": null
    }
  ],
  "replication": {
    "produced_by": [
      "Routine ECGs were analyzed automatically, with warnings sent to physicians and risk reports available in the electronic health record.",
      "Physicians assessed alerted patients and selected care using their clinical judgment."
    ],
    "must_hold": [
      "Reliable ECG transfer and clinicians able to assess alerts are likely requirements. Effectiveness in other health systems requires evaluation."
    ],
    "echoes": []
  },
  "paired_incident": null,
  "headline": "Taiwan AI-ECG alerts reduce mortality in a randomized trial",
  "metric": "3.6% versus 4.3%",
