{
  "id": "AIBD-0579",
  "title": "COMPOSER sepsis alerts are associated with lower mortality at UC San Diego Health",
  "summary": "UC San Diego links COMPOSER to 17% lower sepsis mortality relative to a modeled counterfactual. The comparison was not randomized.",
  "date_observed": "2024-01-23",
  "date_basis": "source publication",
  "date_precision": "day",
  "benefit_status": "reported",
  "source_collection": null,
  "source_entry": null,
  "account": "UC San Diego Health evaluated COMPOSER in two emergency departments among 6,217 adults with sepsis. The model went live on December 7, 2022, with follow-up through April 30, 2023. Post-deployment mortality was 9.49%, compared with a modeled counterfactual of 11.39%: an adjusted reduction of 1.9 percentage points (95% confidence interval 0.3–3.5). Raw pre-deployment mortality was 10.3%. The estimated benefit was statistically significant at one hospital and not the other. The study used historical controls, without randomization or a concurrent untreated group.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "Identify emerging sepsis so that clinical teams can assess and treat patients sooner.",
  "system": "COMPOSER deep-learning sepsis prediction and nurse alert system",
  "model_version": null,
  "developer": "University of California San Diego research team",
  "deployer": "UC San Diego Health",
  "location": "San Diego, California, United States",
  "domain": "Healthcare - sepsis",
  "segment": "Electronic-health-record early warning system",
  "benefit_type": "Improved Physical Health",
  "taxonomy_note": null,
  "registry_ids": {},
  "ratings": [
    {
      "group": "personal",
      "depth": 5,
      "reason": "Lower mortality represents lives preserved. The estimate relies on a historical model rather than randomized assignment."
    }
  ],
  "ai_role": {
    "status": "assessed",
    "statement": "COMPOSER analyzed patient data and alerted nurses to possible sepsis. Nurses reviewed patients with physicians, who selected treatment. The outcome concerns AI-assisted clinical care."
  },
  "evidence": [
    {
      "kind": "peer-reviewed study",
      "citation": "Boussina A, Shashikumar SP, Malhotra A, et al. (2024). npj Digital Medicine 7:14. doi:10.1038/s41746-023-00986-6. Evaluation by COMPOSER's developers and deploying health system.",
      "title": "Impact of a deep learning sepsis prediction model on quality of care and survival",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC10805720/",
      "date": "2024-01-23",
      "written_by": "makers",
      "quote": null
    },
