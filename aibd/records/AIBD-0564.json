  "id": "AIBD-0564",
  "title": "Swindon Borough Council: Simply Readable, an AI easy-read solution",
  "summary": "Swindon reports that Simply Readable creates Easy-Read documents in under 30 minutes at much lower cost, with input from residents with learning disabilities.",
  "date_observed": "2025-02-03",
  "date_basis": "source publication",
  "date_precision": "day",
  "benefit_status": "reported",
  "source_collection": "LGA AI case-study bank",
  "source_entry": "LGA-028",
  "account": "Swindon deployed Simply Readable to produce Easy-Read documents with AI, co-designed with residents with learning disabilities. The council reports document conversion in under 30 minutes and costs of 7–10 pence for material previously costing upwards of £600. Its return-on-investment estimates have not been independently checked. A separate tool provides translation.",
  "category": "general benefit",
  "unexpected": false,
  "purpose": "Produce accessible Easy-Read documents more quickly and cheaply for residents who need them.",
  "system": "Simply Readable, built on Amazon Bedrock with council-selected foundation models",
  "model_version": null,
  "developer": "Swindon Borough Council using Amazon Bedrock",
  "deployer": "Swindon Borough Council",
